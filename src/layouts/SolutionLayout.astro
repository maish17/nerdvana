---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'solutions'>;
}

const { entry } = Astro.props;
const { title, tagline, audience, format, priceFrom } = entry.data;
---

<BaseLayout title={title} description={tagline}>
  <article>
    <header>
      <h1>{title}</h1>
      <p>{tagline}</p>
      <dl>
        <dt>Audience</dt><dd>{audience}</dd>
        <dt>Format</dt><dd>{format}</dd>
        {priceFrom !== undefined && (<><dt>From</dt><dd>${priceFrom}</dd></>)}
      </dl>
    </header>
    <slot />
  </article>
</BaseLayout>

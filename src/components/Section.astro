---
/** Shared section shell: landmark, optional eyebrow, h2, optional intro. */
import { uid } from '../lib/ids';

interface Props {
  heading: string;
  eyebrow?: string;
  intro?: string;
  muted?: boolean;
  /** Intro spans the full container instead of a readable measure. */
  wide?: boolean;
  /** Anchor id, e.g. for /policies/#privacy. */
  id?: string;
}

const { heading, eyebrow, intro, muted = false, wide = false, id } = Astro.props;
const headingId = uid('section');
---

<section id={id} aria-labelledby={headingId} class:list={['py-2xl', muted && 'bg-surface-muted']}>
  <div class="container-page">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={headingId} class:list={[eyebrow && 'mt-xs']}>
      {heading}
    </h2>
    {intro && <p class:list={['mt-lg text-ink-muted', !wide && 'max-w-measure']}>{intro}</p>}
    <div class="mt-lg">
      <slot />
    </div>
  </div>
</section>

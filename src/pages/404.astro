---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSingleton } from '../lib/content';

const { labels } = await getSingleton('siteSettings');
---

<BaseLayout title={labels.notFoundTitle} description={labels.notFoundBody} noindex>
  <section class="container-page py-2xl" aria-labelledby="nf-title">
    <h1 id="nf-title">{labels.notFoundTitle}</h1>
    <p class="mt-md">{labels.notFoundBody}</p>
    <p class="mt-lg">
      <a href="/">{labels.notFoundLink}</a>
    </p>
  </section>
</BaseLayout>

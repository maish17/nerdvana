---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProofStrip from '../components/ProofStrip.astro';
import AudienceRouter from '../components/AudienceRouter.astro';
import ImplementationSteps from '../components/ImplementationSteps.astro';
import ProgramGrid from '../components/ProgramGrid.astro';
import CaseStudyGrid from '../components/CaseStudyGrid.astro';
import Testimonial from '../components/Testimonial.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import ContextualCta from '../components/ContextualCta.astro';
import { getPublishableTestimonial, getSingleton, resolve } from '../lib/content';

const data = await getSingleton('home');
const programs = await resolve(data.programs.programs);
const caseStudies = await resolve(data.caseStudies.caseStudies);
const testimonial = await getPublishableTestimonial(data.testimonial.testimonial);
const faqs = (await resolve(data.faq.faqs)).map((f) => ({
  question: f.data.question,
  answer: f.data.answer,
}));
---

<BaseLayout title={data.seo.title} description={data.seo.description}>
  <Hero {...data.hero} />
  <ProofStrip {...data.proof} />
  <AudienceRouter {...data.audienceRouter} />
  <ImplementationSteps {...data.steps} />
  <ProgramGrid heading={data.programs.heading} intro={data.programs.intro} programs={programs} />
  <CaseStudyGrid
    heading={data.caseStudies.heading}
    intro={data.caseStudies.intro}
    caseStudies={caseStudies}
  />
  {testimonial && <Testimonial {...testimonial} />}
  <FaqAccordion heading={data.faq.heading} items={faqs} />
  <ContextualCta {...data.cta} />
</BaseLayout>

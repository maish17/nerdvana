---
/** Homepage. Section order follows the approved design and is fixed here. */
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandHero from '../components/BrandHero.astro';
import TextSection from '../components/TextSection.astro';
import Carousel from '../components/Carousel.astro';
import ProofStrip from '../components/ProofStrip.astro';
import AudienceRouter from '../components/AudienceRouter.astro';
import ContextualCta from '../components/ContextualCta.astro';
import { getSingleton } from '../lib/content';

const data = await getSingleton('home');
const { labels } = await getSingleton('siteSettings');
---

<BaseLayout title={data.seo.title} description={data.seo.description}>
  <BrandHero {...data.hero} />
  <TextSection {...data.intro} />
  <Carousel
    {...data.spotlight}
    labels={{
      previous: labels.carouselPrevious,
      next: labels.carouselNext,
      show: labels.carouselShow,
    }}
  />
  <TextSection {...data.story} />
  <ProofStrip {...data.proof} />
  <AudienceRouter {...data.audienceRouter} />
  <ContextualCta {...data.cta} />
</BaseLayout>
